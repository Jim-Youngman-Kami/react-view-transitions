# React experimental builds are versioned `0.0.0-experimental-<sha>`, which never
# satisfies a peer range like `react@>=19.2.7`. npm treats that as a hard ERESOLVE
# error when installing anything with a React peer dependency (react-router), so
# this flag is required for npm. pnpm ignores `legacy-peer-deps` and only warns on
# peer mismatches by default, so it needs nothing here — the flag is kept for
# anyone falling back to npm.
legacy-peer-deps=true

# Do NOT loosen the react/react-dom pins in package.json to a caret range. A caret
# over a prerelease (`^0.0.0-experimental-<sha>`) still matches every other
# `0.0.0-*` build, and prerelease tags compare ASCII-wise — so old nightlies like
# `0.0.0-fec00a869` sort ABOVE `0.0.0-experimental-...` and win resolution. That
# silently installs a React 16-era build with no `react-dom/client` export.
